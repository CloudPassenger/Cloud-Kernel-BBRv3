# Maintainer: Cloud Kernel BBRv3 Maintainers <noreply@cloud-kernel-bbrv3.invalid>
pkgname=linux-cloud-bbrv3
pkgver=@KERNEL_VERSION@
pkgrel=0
_kernel_release=@KERNEL_RELEASE@
pkgdesc="Cloud kernel with BBRv3 and custom congestion controls"
url="https://github.com/CloudPassenger/Cloud-Kernel-BBRv3"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="initramfs-generator linux-firmware-any"
makedepends="$_depends_dev bc binutils bpftool diffutils findutils gawk
	installkernel jq linux-headers openssl-dev python3 rsync sed"
options="!strip !check"
source="compiled-kernel.tar.zst
	LICENSE
	NOTICE
	Unlicense.txt
	GPL-2.0-only.txt
	BSD-3-Clause.txt
	CC0-1.0.txt"
install="$pkgname.post-deinstall"
subpackages="$pkgname-dev:_dev:$CBUILD_ARCH"
builddir="$srcdir/linux"

_kernelarch() {
	case "$1" in
		x86_64) echo x86 ;;
		aarch64) echo arm64 ;;
		*) return 1 ;;
	esac
}

_install_license_bundle() {
	local license_dir=$1
	install -Dm644 "$srcdir/LICENSE" "$license_dir/LICENSE"
	install -Dm644 "$srcdir/NOTICE" "$license_dir/NOTICE"
	local license
	for license in Unlicense.txt GPL-2.0-only.txt BSD-3-Clause.txt CC0-1.0.txt; do
		install -Dm644 "$srcdir/$license" "$license_dir/LICENSES/$license"
	done
}
build() {
	local karch="$(_kernelarch "$CARCH")"
	cd "$builddir"

	local release
	release=$(make -s ARCH="$karch" kernelrelease)
	if [ "$release" != "$_kernel_release" ]; then
		error "expected kernel release $_kernel_release, got $release"
		return 1
	fi

	# Refresh host-side build tooling (fixdep, modpost, sign-file, ...)
	# against musl. The vmlinux/*.ko objects were already compiled once
	# by build_kernel.sh and are left untouched.
	make ARCH="$karch" \
		V=@MAKE_VERBOSITY@ \
		CC=gcc \
		HOSTCC=gcc \
		AWK="${AWK:-gawk}" \
		modules_prepare
}

package() {
	local karch="$(_kernelarch "$CARCH")"
	cd "$builddir"
	local release
	release=$(make -s ARCH="$karch" kernelrelease)

	mkdir -p "$pkgdir/boot" "$pkgdir/lib/modules/$release"
	make ARCH="$karch" \
		V=@MAKE_VERBOSITY@ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		DEPMOD=true \
		modules_install
	bash .external-modules/check.sh package \
		"$pkgdir/lib/modules/$release" \
		.external-modules/manifest.json

	local image_path
	image_path=$(make -s ARCH="$karch" image_name)
	install -Dm644 "$image_path" "$pkgdir/boot/vmlinuz-cloud-bbrv3"
	install -Dm644 System.map "$pkgdir/boot/System.map-$release"
	install -Dm644 .config "$pkgdir/boot/config-$release"
	install -Dm644 include/config/kernel.release \
		"$pkgdir/usr/share/kernel/cloud-bbrv3/kernel.release"

	if [ -d "arch/$karch/boot/dts" ]; then
		make ARCH="$karch" \
			V=@MAKE_VERBOSITY@ \
			INSTALL_DTBS_PATH="$pkgdir/boot/dtbs-cloud-bbrv3" \
			dtbs_install
	fi

	rm -f "$pkgdir/lib/modules/$release/build" \
		"$pkgdir/lib/modules/$release/source"
	rm -rf "$pkgdir/lib/firmware"
	printf '%s\n' '-cloud-bbrv3' > "$pkgdir/lib/modules/$release/kernel-suffix"
	ln -sf /boot/vmlinuz-cloud-bbrv3 \
		"$pkgdir/lib/modules/$release/vmlinuz"
	_install_license_bundle "$pkgdir/usr/share/licenses/$pkgname"
}

_dev() {
	local karch="$(_kernelarch "$CARCH")"
	cd "$builddir"
	local release
	release=$(make -s ARCH="$karch" kernelrelease)
	local dir="$subpkgdir/usr/src/linux-headers-$release"

	pkgdesc="Headers and scripts for external modules on $release"
	depends="$_depends_dev"
	install="linux-cloud-bbrv3-dev.post-deinstall"

	make ARCH="$karch" run-command \
		V=@MAKE_VERBOSITY@ \
		KBUILD_RUN_COMMAND="${builddir}/scripts/package/install-extmod-build $dir"
	mkdir -p "$subpkgdir/lib/modules/$release"
	ln -sf /usr/src/linux-headers-$release \
		"$subpkgdir/lib/modules/$release/build"

	if [ -f certs/signing_key.x509 ]; then
		install -Dm644 certs/signing_key.x509 "$dir/certs/signing_key.x509"
	fi
	_install_license_bundle "$subpkgdir/usr/share/licenses/$subpkgname"
}
