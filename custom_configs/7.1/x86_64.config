# x86_64 custom kernel config fragment (minimal)
#
# Contains options that differ from Debian's cloud-amd64 defaults.
# Merged by .github/scripts/apply_config.sh 7.1 x86_64.

# Kernel introspection
# CONFIG_SCHED_CLASS_EXT is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Virtualization / hypervisor guest support
CONFIG_XEN_VIRTIO=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y
CONFIG_VIRTIO_RTC=m

# Confidential computing (EFI secret)
CONFIG_EFI_SECRET=m

# CPU vulnerability mitigations
# Disabled by project policy for constrained VPS guests.
# CONFIG_CPU_MITIGATIONS is not set

# TCP congestion control (BBR family)
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR1=m
CONFIG_TCP_CONG_BBRPLUS=m
CONFIG_TCP_CONG_BRUTAL=m
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Default qdisc for BBR pacing
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_FQ_CODEL is not set
CONFIG_DEFAULT_NET_SCH="fq"

# Netfilter flow offload
CONFIG_NFT_REJECT_NETDEV=m
CONFIG_NETFILTER_XT_TARGET_FLOWOFFLOAD=m

# Boot framebuffer console (EFI/virtual GPU)
CONFIG_SYSFB_SIMPLEFB=y

# Small-memory VPS defaults
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_NUMA_BALANCING_DEFAULT_ENABLED is not set
# CONFIG_DEBUG_LIST is not set
CONFIG_LIST_HARDENED=y

# ZRAM swap compression
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y

# VPS/server CPU scalability
# CONFIG_MAXSMP is not set
CONFIG_NR_CPUS=512
CONFIG_NODES_SHIFT=6

# NIC driver trim
# CONFIG_NET_VENDOR_CORTINA is not set
# CONFIG_NET_VENDOR_ENGLEDER is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_LITEX is not set
# CONFIG_NET_VENDOR_META is not set
# CONFIG_NET_VENDOR_VERTEXCOM is not set
# CONFIG_NET_VENDOR_WANGXUN is not set
# CONFIG_NET_VENDOR_XILINX is not set

# Legacy virtual/physical NIC compat (some cloud hosts still emulate the
# classic QEMU e1000 vNIC instead of virtio_net, or ship e1000e-based
# physical NICs; Debian's cloud-amd64 config drops both by default)
CONFIG_E1000=m
CONFIG_E1000E=m

# Watchdog
CONFIG_SOFT_WATCHDOG_PRETIMEOUT=y

# Unneeded laptop platform
# CONFIG_SURFACE_PLATFORMS is not set

# Accelerated ciphers
CONFIG_CRYPTO_SM4_AESNI_AVX_X86_64=m
CONFIG_CRYPTO_SM4_AESNI_AVX2_X86_64=m
CONFIG_CRYPTO_ARIA_AESNI_AVX_X86_64=m
CONFIG_CRYPTO_ARIA_AESNI_AVX2_X86_64=m
CONFIG_CRYPTO_ARIA_GFNI_AVX512_X86_64=m
CONFIG_CRYPTO_SM3=m
