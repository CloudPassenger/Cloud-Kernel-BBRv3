# x86_64 custom kernel config fragment (minimal)
#
# Carried over from custom_configs/6.18/x86_64.config as the starting point for
# kernel series 7.1. CONFIG_SCHED_CLASS_EXT, CONFIG_X86_MSR and
# CONFIG_NFT_REJECT_NETDEV were verified directly against upstream kernel.org
# 7.1.6 Kconfig sources on 2026-08-06 and are unchanged from 6.12/6.18 (same
# names, same dependencies). No local 7.1 olddefconfig merge was run end-to-end
# during investigation, so still treat this as a starting point to spot-check
# on the first real 7.1 CI build, but there is no known drift to chase.

# Kernel introspection
CONFIG_SCHED_CLASS_EXT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Virtualization / hypervisor guest support
CONFIG_XEN_VIRTIO=y
CONFIG_XEN_PRIVCMD_EVENTFD=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y
CONFIG_X86_MSR=y
CONFIG_X86_CPUID=y
CONFIG_VMWARE_VMCI=y
CONFIG_VIRTIO_VFIO_PCI=m
CONFIG_VDPA_SIM=m
CONFIG_VP_VDPA=m

# Confidential computing (EFI secret)
CONFIG_EFI_SECRET=m

# CPU vulnerability mitigations
# NOTE: disables Spectre/Meltdown/MDS/L1TF/etc. hardware mitigations
# for performance. Only acceptable on trusted/dedicated tenancy.
# CONFIG_CPU_MITIGATIONS is not set

# TCP congestion control (BBR family)
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR1=y
CONFIG_TCP_CONG_BRUTAL=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Netfilter flow offload
CONFIG_NFT_REJECT_NETDEV=m
CONFIG_NETFILTER_XT_TARGET_FLOWOFFLOAD=m

# Boot framebuffer console (EFI/virtual GPU)
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE_LEGACY_ACCELERATION=y

# ZRAM swap compression
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y

# Storage multipath handlers
CONFIG_DM_MULTIPATH_HST=m
CONFIG_DM_MULTIPATH_IOA=m

# iSCSI/LIO target core
CONFIG_REMOTE_TARGET=m

# NIC driver trim + Intel IDPF
# CONFIG_NET_VENDOR_CORTINA is not set
# CONFIG_NET_VENDOR_ENGLEDER is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_LITEX is not set
# CONFIG_NET_VENDOR_META is not set
# CONFIG_NET_VENDOR_VERTEXCOM is not set
# CONFIG_NET_VENDOR_WANGXUN is not set
# CONFIG_NET_VENDOR_XILINX is not set
CONFIG_IDPF_SINGLEQ=y

# PTP clock (VMware guest)
CONFIG_PTP_1588_CLOCK_VMW=y

# Watchdog
CONFIG_SOFT_WATCHDOG_PRETIMEOUT=y

# Unneeded laptop platform
# CONFIG_SURFACE_PLATFORMS is not set

# AVX-accelerated ciphers (SM4/ARIA/POLYVAL/SM3)
CONFIG_CRYPTO_SM4_AESNI_AVX_X86_64=m
CONFIG_CRYPTO_SM4_AESNI_AVX2_X86_64=m
CONFIG_CRYPTO_ARIA_AESNI_AVX_X86_64=m
CONFIG_CRYPTO_ARIA_AESNI_AVX2_X86_64=m
CONFIG_CRYPTO_ARIA_GFNI_AVX512_X86_64=m
CONFIG_CRYPTO_POLYVAL_CLMUL_NI=m
CONFIG_CRYPTO_SM3_AVX_X86_64=m
