# arm64 custom kernel config fragment (minimal)
#
# Carried over from custom_configs/6.18/arm64.config as the starting point for
# kernel series 7.1. CONFIG_SCHED_CLASS_EXT and CONFIG_NFT_REJECT_NETDEV were
# verified directly against upstream kernel.org 7.1.6 Kconfig sources on
# 2026-08-06 and are unchanged from 6.12/6.18 (same names, same dependencies).
# No local 7.1 olddefconfig merge was run end-to-end during investigation, so
# still treat this as a starting point to spot-check on the first real 7.1 CI
# build, but there is no known drift to chase.

# Kernel introspection
CONFIG_SCHED_CLASS_EXT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Virtualization / hypervisor guest support
CONFIG_ARM_PKVM_GUEST=y
CONFIG_VDPA_SIM=m
CONFIG_VP_VDPA=m
CONFIG_XEN_VIRTIO=y
CONFIG_XEN_PRIVCMD_EVENTFD=y

# EFI zboot
CONFIG_EFI_ZBOOT=y

# TCP congestion control (BBR family)
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR1=y
CONFIG_TCP_CONG_BRUTAL=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# Netfilter flow offload
CONFIG_NFT_REJECT_NETDEV=m
CONFIG_NETFILTER_XT_TARGET_FLOWOFFLOAD=m

# Boot framebuffer console (EFI/virtual GPU)
CONFIG_SYSFB_SIMPLEFB=y

# ZRAM swap compression
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_MULTI_COMP=y

# Virtio GPIO / Hyper-V UIO
CONFIG_GPIO_VIRTIO=m
CONFIG_UIO_HV_GENERIC=m

# NIC driver trim + Intel IDPF + NXP PHY
# CONFIG_NET_VENDOR_CORTINA is not set
# CONFIG_NET_VENDOR_DAVICOM is not set
# CONFIG_NET_VENDOR_ENGLEDER is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_LITEX is not set
# CONFIG_NET_VENDOR_META is not set
# CONFIG_NET_VENDOR_VERTEXCOM is not set
# CONFIG_NET_VENDOR_WANGXUN is not set
# CONFIG_NET_VENDOR_XILINX is not set
CONFIG_NXP_CBTX_PHY=m
CONFIG_IDPF_SINGLEQ=y

# PTP clock (VMware guest)
CONFIG_PTP_1588_CLOCK_VMW=y

# Watchdog
CONFIG_SOFT_WATCHDOG_PRETIMEOUT=y
# CONFIG_MARVELL_GTI_WDT is not set

# Unneeded laptop platform
# CONFIG_SURFACE_PLATFORMS is not set

# ARMv8 crypto extension / SM ciphers
CONFIG_CRYPTO_ECDSA=m
CONFIG_CRYPTO_ARIA=m
CONFIG_CRYPTO_HCTR2=m
CONFIG_HW_RANDOM_CCTRNG=m
CONFIG_CRYPTO_SM3_NEON=m
CONFIG_CRYPTO_SM3_ARM64_CE=m
CONFIG_CRYPTO_AES_ARM64=m
CONFIG_CRYPTO_SM4_ARM64_CE=m
CONFIG_CRYPTO_SM4_ARM64_CE_BLK=m
CONFIG_CRYPTO_SM4_ARM64_NEON_BLK=m
CONFIG_CRYPTO_SM4_ARM64_CE_CCM=m
CONFIG_CRYPTO_SM4_ARM64_CE_GCM=m
